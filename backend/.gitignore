# ----------------------------------------
# 🐍 Django / Python Backend Ignore Rules
# ----------------------------------------

# Compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Django migrations cache
*.mo
*.pot

# SQLite database
db.sqlite3

# Environment files
.env
.env.local
*.env

# Logs and debug
*.log
*.pot
*.pyproj
*.suo
*.user
*.cache
*.pdb
*.tmp
*.bak

# Virtual environments
venv/
env/
ENV/
.venv/

# IDEs and editors
.vscode/
.idea/
*.code-workspace

# Byte-compiled files
*.pyc

# PyInstaller
*.manifest
*.spec

# MyPy cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Django media/static (generated)
media/
staticfiles/
collectstatic/
__pycache__/

# Coverage / testing
.coverage
.tox/
.nox/
.pytest_cache/
htmlcov/
.cache/

# Local config files
local_settings.py
settings_local.py

# Docker / VS Code dev containers
Dockerfile
.dockerignore
*.pid
