# /backend/misionemprende/Dockerfile

# Usamos la imagen base de Python
FROM python:3.11-slim

# Establece el directorio de trabajo: /app equivale a /backend/misionemprende
WORKDIR /app 

# Añade la ruta de trabajo al PYTHONPATH para encontrar apps como 'api'
ENV PYTHONPATH=/app

# 🛑 PASO CLAVE: Instalar herramientas para descargar wait-for-it.sh
RUN apt-get update && apt-get install -y curl && \
    curl -o /usr/local/bin/wait-for-it.sh https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh && \
    chmod +x /usr/local/bin/wait-for-it.sh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copia e instala dependencias
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copia el resto del código
COPY . /app/

EXPOSE 8000