# ----------------------------------------------------------------
# Comentarios de GitHub
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ----------------------------------------------------------------
# Dependencias y Logs (Node.js / Frontend)
# Ignorar dependencias de Node del frontend
/frontend/node_modules

# Ignorar archivos comprimidos
*.rar

# Ignorar el archivo 'tatus' que vi
tatus
# Ignora todos los node_modules en cualquier carpeta
**/node_modules

# Archivos de Yarn PnP
/.pnp
.pnp.js

# Carpetas de build y testing
/build
/dist
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ----------------------------------------------------------------
# Dependencias y Cache (Python / Django / Backend)

# Entornos virtuales (¡MUY IMPORTANTE!)
# Reemplaza 'venv/' por el nombre de tu entorno si es diferente
venv/
env/
.venv/
.env/

# Cache de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Bases de datos locales
*.sqlite3

# ----------------------------------------------------------------
# Archivos de Entorno y Configuración (¡CRÍTICO!)
# Nunca subas tus claves secretas o contraseñas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ----------------------------------------------------------------
# Configuraciones de IDEs y Sistema Operativo

# VSCode
.vscode/

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Mac
.DS_Store

*.rar